# Frontend Environment Variables

# API
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1

# Web3
NEXT_PUBLIC_WEB3_CHAIN_ID=1
NEXT_PUBLIC_WEB3_NETWORK=mainnet
NEXT_PUBLIC_WEB3_RPC_URL=https://mainnet.infura.io/v3/your-project-id

# Smart Contracts
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your-walletconnect-project-id

# IPFS
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Feature Flags
NEXT_PUBLIC_FEATURE_P2P_ENABLED=false
NEXT_PUBLIC_FEATURE_STAKING_ENABLED=true
NEXT_PUBLIC_FEATURE_SUBSCRIPTION_ENABLED=true

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# UI
NEXT_PUBLIC_APP_NAME=NEXUS Search
NEXT_PUBLIC_APP_DESCRIPTION=Децентрализованная поисковая система нового поколения
