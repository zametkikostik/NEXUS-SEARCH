# Backend Environment Variables
# Copy this file to .env

# ===========================================
# REQUIRED - Change these!
# ===========================================

# Application
APP_NAME=NEXUS Search Backend
DEBUG=false
LOG_LEVEL=info
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# JWT Secret (GENERATE SECURE RANDOM STRING - min 32 chars!)
# Use: openssl rand -hex 32
JWT_SECRET=change-me-in-production-min-32-chars

# Web3 Provider (Infura/Alchemy/Local node)
WEB3_PROVIDER_URI=https://eth-mainnet.g.alchemy.com/v2/YOUR_PROJECT_ID
WEB3_CHAIN_ID=1
WEB3_NETWORK=mainnet

# ===========================================
# Redis Configuration
# ===========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
DATABASE_URL=redis://localhost:6379/0

# Cache TTL (seconds)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_NEWS=300
CACHE_TTL_STATIC=86400

# ===========================================
# IPFS Configuration
# ===========================================

IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ===========================================
# Smart Contracts
# ===========================================

CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
STAKING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
SUBSCRIPTION_NFT_ADDRESS=0x0000000000000000000000000000000000000000

# ===========================================
# JWT Configuration
# ===========================================

JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7
SIGNATURE_EXPIRATION_MINUTES=10

# ===========================================
# Rate Limiting
# ===========================================

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# Query Limits
SEARCH_LIMIT_DEFAULT=10
SEARCH_LIMIT_MAX=50

# ===========================================
# Proxy Configuration (Anti-Bot)
# ===========================================

PROXY_ROTATION_ENABLED=true
PROXY_LIST_FILE=proxies.txt
PROXY_TIMEOUT=10
PROXY_MAX_RETRIES=3

# Residential Proxies (paid services - optional)
PROXY_PROVIDER_URL=
PROXY_PROVIDER_API_KEY=

# Datacenter Proxies (comma-separated)
DATACENTER_PROXIES=

# Tor Proxy (optional)
TOR_PROXY_ENABLED=false
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050

# Request Settings
REQUEST_TIMEOUT=30
REQUEST_MAX_RETRIES=3
REQUEST_BACKOFF_FACTOR=1.5
REQUEST_USER_AGENT_ROTATION=true

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_TIMEOUT=30

# ===========================================
# Content Filtering
# ===========================================

FILTER_ENABLED=true
FILTER_BLACKLIST_FILE=blacklist.txt
FILTER_ML_MODEL_PATH=models/content_filter_model.pkl
FILTER_CONFIDENCE_THRESHOLD=0.7

# Blacklist Categories
BLOCK_EXTREMISM=true
BLOCK_TERRORISM=true
BLOCK_PROPAGANDA=true
BLOCK_ADULT_CONTENT=false

# ===========================================
# Search Providers
# ===========================================

# Google (requires API key)
GOOGLE_ENABLED=true
GOOGLE_API_KEY=
GOOGLE_CX=

# DuckDuckGo (no API key required)
DUCKDUCKGO_ENABLED=true

# Brave Search (requires API key)
BRAVE_ENABLED=true
BRAVE_API_KEY=

# Yandex (no API key required)
YANDEX_ENABLED=true
YANDEX_API_KEY=

# Dzen (no API key required)
DZEN_ENABLED=true

# Reddit (no API key required)
REDDIT_ENABLED=true

# Provider Timeouts (seconds)
PROVIDER_TIMEOUT_DEFAULT=10
PROVIDER_TIMEOUT_GOOGLE=15
PROVIDER_TIMEOUT_DUCKDUCKGO=10

# ===========================================
# Monitoring & Logging
# ===========================================

PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Sentry (optional - for error tracking)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# Security
# ===========================================

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# ===========================================
# Payment & Tokenomics
# ===========================================

MINIMUM_TOKEN_BALANCE=1
PAY_PER_SEARCH_AMOUNT=0.01
STAKING_REWARD_RATE=0.05

# ===========================================
# P2P Node System (optional)
# ===========================================

P2P_NODE_ENABLED=false
P2P_NODE_PORT=8081
P2P_BOOTSTRAP_NODES=
