# Backend Environment Variables

# Application
APP_NAME=NEXUS Search Backend
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
DATABASE_URL=redis://localhost:6379/0

# Redis TTL (seconds)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_NEWS=300
CACHE_TTL_STATIC=86400

# IPFS
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Web3
WEB3_PROVIDER_URI=http://localhost:8545
WEB3_CHAIN_ID=1
WEB3_NETWORK=mainnet

# Smart Contract
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Wallet Signature
SIGNATURE_EXPIRATION_MINUTES=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# Query Limits
SEARCH_LIMIT_DEFAULT=10
SEARCH_LIMIT_MAX=50

# Proxy Configuration
PROXY_ROTATION_ENABLED=true
PROXY_LIST_FILE=proxies.txt
PROXY_TIMEOUT=10
PROXY_MAX_RETRIES=3

# Residential Proxies (paid services)
PROXY_PROVIDER_URL=
PROXY_PROVIDER_API_KEY=

# Datacenter Proxies
DATACENTER_PROXIES=

# Tor Proxy
TOR_PROXY_ENABLED=false
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050

# Request Settings
REQUEST_TIMEOUT=30
REQUEST_MAX_RETRIES=3
REQUEST_BACKOFF_FACTOR=1.5
REQUEST_USER_AGENT_ROTATION=true

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_TIMEOUT=30

# Content Filtering
FILTER_ENABLED=true
FILTER_BLACKLIST_FILE=blacklist.txt
FILTER_ML_MODEL_PATH=models/content_filter_model.pkl
FILTER_CONFIDENCE_THRESHOLD=0.7

# Blacklist Categories
BLOCK_EXTREMISM=true
BLOCK_TERRORISM=true
BLOCK_PROPAGANDA=true
BLOCK_ADULT_CONTENT=false

# Providers Configuration
GOOGLE_ENABLED=true
GOOGLE_API_KEY=
GOOGLE_CX=

DUCKDUCKGO_ENABLED=true
BRAVE_ENABLED=true
BRAVE_API_KEY=

YANDEX_ENABLED=true
YANDEX_API_KEY=

DZEN_ENABLED=true
REDDIT_ENABLED=true

# Provider Timeouts (seconds)
PROVIDER_TIMEOUT_DEFAULT=10
PROVIDER_TIMEOUT_GOOGLE=15
PROVIDER_TIMEOUT_DUCKDUCKGO=10

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Node System (P2P)
P2P_NODE_ENABLED=false
P2P_NODE_PORT=8081
P2P_BOOTSTRAP_NODES=

# Tokenomics
TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_DECIMALS=18
MINIMUM_TOKEN_BALANCE=1

# Payment
PAY_PER_SEARCH_AMOUNT=0.01
SUBSCRIPTION_NFT_ADDRESS=0x0000000000000000000000000000000000000000

# Staking
STAKING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
STAKING_REWARD_RATE=0.05
