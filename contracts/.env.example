# Contracts Environment Variables

# Deployer
PRIVATE_KEY=your_private_key_here

# RPC URLs
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Etherscan API Key
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Contract Addresses (after deployment)
NXS_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NXS_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
NXS_SUBSCRIPTION_ADDRESS=0x0000000000000000000000000000000000000000
